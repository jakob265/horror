; Engine configuration file for Void Frequency (Godot 4 port).
; If you import this folder into Godot 4.x it will set itself up automatically.

config_version=5

[application]

config/name="Void Frequency"
config/description="A first-person walking-simulator horror game.
Procedurally generated geometry, runtime audio, no external assets required."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoload/game_state.gd"
NotesData="*res://autoload/notes_data.gd"
NotesManager="*res://autoload/notes_manager.gd"
InteractionManager="*res://autoload/interaction_manager.gd"
OlenManager="*res://autoload/olen_manager.gd"
ShapeTracker="*res://autoload/shape_tracker.gd"
AudioManager="*res://autoload/audio_manager.gd"
SceneRouter="*res://autoload/scene_router.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
mouse_cursor/custom_image=""

